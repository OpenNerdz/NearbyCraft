<configs>
  <append xpath="/blocks">
    <block name="nearbyCraftStorageTerminal">
      <property name="CreativeMode" value="Player" />
      <property name="Class" value="CompositeTileEntity" />
      <property class="CompositeFeatures">
        <property class="TEFeatureStorage">
          <property name="LootList" value="nearbyCraftTerminalInternal" />
        </property>
        <property class="TEFeatureLockable" />
        <property class="TEFeaturePickup">
          <property name="TakeDelay" value="15" />
        </property>
      </property>
      <property name="DescriptionKey" value="nearbyCraftStorageTerminalDesc" />
      <property class="UpgradeBlock">
        <property name="ToBlock" value="nearbyCraftStorageTerminalTier2" />
        <property name="Item" value="nearbyCraftTerminalUpgrade2" />
        <property name="ItemCount" value="1" />
        <property name="UpgradeHitCount" value="4" />
      </property>
      <property name="CustomIcon" value="controlPanelBase01" />
      <property name="Material" value="Mmetal" />
      <property name="Shape" value="ModelEntity" />
      <property name="Model" value="@:Entities/Industrial/controlPanelBase_01Prefab.prefab" />
      <property name="ModelOffset" value="0,0,0" />
      <property name="WaterFlow" value="permitted" />
      <property name="Path" value="solid" />
      <property name="Place" value="TowardsPlacerInverted" />
      <property name="AllowedRotations" value="Basic90" />
      <property name="MaxDamage" value="1500" />
      <property name="EconomicValue" value="600" />
      <property name="SoundPickup" value="steel_misc_hvy_grab" />
      <property name="SoundPlace" value="steel_misc_hvy_place" />
      <property class="RepairItems">
        <property name="resourceForgedSteel" value="5" />
        <property name="resourceElectricParts" value="5" />
      </property>
      <drop event="Destroy" name="resourceScrapIron" count="10,20" />
      <property name="SortOrder1" value="B163" />
      <property name="SortOrder2" value="0000" />
      <property name="Group" value="Basics,Building,advBuilding" />
      <property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
      <property name="Tags" value="timecharge" />
    </block>
    <block name="nearbyCraftStorageTerminalTier2">
      <property name="Extends" value="nearbyCraftStorageTerminal" />
      <property name="DescriptionKey" value="nearbyCraftStorageTerminalTier2Desc" />
      <property name="CustomIconTint" value="46be5a" />
      <property name="EconomicValue" value="1000" />
      <property class="UpgradeBlock">
        <property name="ToBlock" value="nearbyCraftStorageTerminalTier3" />
        <property name="Item" value="nearbyCraftTerminalUpgrade3" />
        <property name="ItemCount" value="1" />
        <property name="UpgradeHitCount" value="4" />
      </property>
    </block>
    <block name="nearbyCraftStorageTerminalTier3">
      <property name="Extends" value="nearbyCraftStorageTerminal" />
      <property name="DescriptionKey" value="nearbyCraftStorageTerminalTier3Desc" />
      <property name="CustomIconTint" value="5096f0" />
      <property name="EconomicValue" value="1800" />
      <property class="UpgradeBlock">
        <property name="ToBlock" value="nearbyCraftStorageTerminalTier4" />
        <property name="Item" value="nearbyCraftTerminalUpgrade4" />
        <property name="ItemCount" value="1" />
        <property name="UpgradeHitCount" value="4" />
      </property>
    </block>
    <block name="nearbyCraftStorageTerminalTier4">
      <!-- Final tier is explicit: inheriting Tier 1 would also inherit its
           UpgradeBlock, and an empty ToBlock is a fatal V3.2 load error. -->
      <property name="CreativeMode" value="Player" />
      <property name="Class" value="CompositeTileEntity" />
      <property class="CompositeFeatures">
        <property class="TEFeatureStorage">
          <property name="LootList" value="nearbyCraftTerminalInternal" />
        </property>
        <property class="TEFeatureLockable" />
        <property class="TEFeaturePickup">
          <property name="TakeDelay" value="15" />
        </property>
      </property>
      <property name="DescriptionKey" value="nearbyCraftStorageTerminalTier4Desc" />
      <property name="CustomIcon" value="controlPanelBase01" />
      <property name="CustomIconTint" value="c86ef0" />
      <property name="Material" value="Mmetal" />
      <property name="Shape" value="ModelEntity" />
      <property name="Model" value="@:Entities/Industrial/controlPanelBase_01Prefab.prefab" />
      <property name="ModelOffset" value="0,0,0" />
      <property name="WaterFlow" value="permitted" />
      <property name="Path" value="solid" />
      <property name="Place" value="TowardsPlacerInverted" />
      <property name="AllowedRotations" value="Basic90" />
      <property name="MaxDamage" value="1500" />
      <property name="EconomicValue" value="3400" />
      <property name="SoundPickup" value="steel_misc_hvy_grab" />
      <property name="SoundPlace" value="steel_misc_hvy_place" />
      <property class="RepairItems">
        <property name="resourceForgedSteel" value="5" />
        <property name="resourceElectricParts" value="5" />
      </property>
      <drop event="Destroy" name="resourceScrapIron" count="10,20" />
      <property name="SortOrder1" value="B163" />
      <property name="SortOrder2" value="0003" />
      <property name="Group" value="Basics,Building,advBuilding" />
      <property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
      <property name="Tags" value="timecharge" />
    </block>
  </append>
</configs>
